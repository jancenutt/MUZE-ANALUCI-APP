{
  "name": "LibraryItem",
  "type": "object",
  "properties": {
    "app_user_id": {
      "type": "string",
      "description": "Member who owns this drop."
    },
    "user_email": {
      "type": "string",
      "description": "Signup address the drop was delivered to."
    },
    "release_id": {
      "type": "string"
    },
    "release_title": {
      "type": "string"
    },
    "release_month": {
      "type": "string",
      "description": "Drop month (YYYY-MM) this was earned in."
    },
    "content_type": {
      "type": "string",
      "enum": [
        "audio",
        "video",
        "image",
        "document",
        "mixed"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple",
        "yellow",
        "gray"
      ],
      "default": "audio"
    },
    "product_id": {
      "type": "string",
      "description": "Membership the drop was earned under."
    },
    "delivery_kind": {
      "type": "string",
      "enum": [
        "drop",
        "full-library"
      ],
      "enumColors": [
        "green",
        "blue"
      ],
      "default": "drop"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time this drop was emailed to the member."
    }
  },
  "required": [
    "app_user_id",
    "release_title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.app_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}